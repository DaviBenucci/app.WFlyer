{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wflyer.local/schemas/pre-mortem-register.schema.json",
  "type": "object",
  "required": [
    "version",
    "failure_modes"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "failure_modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "family",
          "failure",
          "detection",
          "safe_behavior",
          "status",
          "test_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^PM-[0-9]{3}$"
          },
          "family": {
            "type": "string"
          },
          "failure": {
            "type": "string"
          },
          "detection": {
            "type": "string"
          },
          "safe_behavior": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "test_status": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
