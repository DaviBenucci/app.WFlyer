{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wflyer.local/schemas/baseline-manifest.schema.json",
  "type": "object",
  "required": [
    "version",
    "product",
    "environment",
    "baselines"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "product": {
      "const": "W_Flyer"
    },
    "environment": {
      "type": "object"
    },
    "baselines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "width",
          "height",
          "status",
          "generated_from"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string"
          },
          "generated_from": {
            "type": "string"
          },
          "generated_at": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
