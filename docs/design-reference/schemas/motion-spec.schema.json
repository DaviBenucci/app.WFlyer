{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wflyer.local/schemas/motion-spec.schema.json",
  "type": "object",
  "required": [
    "id",
    "status",
    "name",
    "engine",
    "semantic_rule",
    "requirements",
    "forbidden"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^WF-MOTION-"
    },
    "status": {
      "enum": [
        "binding",
        "binding-composition",
        "reference",
        "draft"
      ]
    },
    "name": {
      "type": "string"
    },
    "engine": {
      "type": "string"
    },
    "semantic_rule": {
      "type": "string"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "forbidden": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
