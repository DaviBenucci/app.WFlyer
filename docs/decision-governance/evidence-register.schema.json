{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-register.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "updated_at",
    "status_order",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "updated_at": {
      "type": "string"
    },
    "status_order": {
      "type": "array",
      "items": {
        "enum": [
          "NOT_STARTED",
          "PLANNED",
          "IN_PROGRESS",
          "READY_FOR_REVIEW",
          "ACCEPTED",
          "REJECTED",
          "STALE"
        ]
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "status",
          "type",
          "decision_ids",
          "required_artifacts",
          "planned_location",
          "owner_role",
          "due_before",
          "acceptance",
          "freshness_policy",
          "artifact_paths",
          "review_record",
          "source_commit",
          "environment",
          "collected_at",
          "expires_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^EVID-[0-9]{3}$"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "enum": [
              "NOT_STARTED",
              "PLANNED",
              "IN_PROGRESS",
              "READY_FOR_REVIEW",
              "ACCEPTED",
              "REJECTED",
              "STALE"
            ]
          },
          "type": {
            "type": "string"
          },
          "decision_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^DEC-[0-9]{3}$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "required_artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "planned_location": {
            "type": "string"
          },
          "owner_role": {
            "type": "string"
          },
          "due_before": {
            "type": "string"
          },
          "acceptance": {
            "type": "string"
          },
          "freshness_policy": {
            "type": "string"
          },
          "artifact_paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "review_record": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_commit": {
            "type": [
              "string",
              "null"
            ]
          },
          "environment": {
            "type": [
              "string",
              "null"
            ]
          },
          "collected_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
